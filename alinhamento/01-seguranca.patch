+                log.warn("AVISO: credencial do Firebase não encontrada "
+                        + "(FIREBASE_CONFIG_FILE, FIREBASE_CREDENTIALS_JSON ou serviceAccountKey.json). O Firebase ficará inativo.");
                 return;
